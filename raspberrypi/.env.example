MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=ai-myaong-raspberrypi
MQTT_TOPICS=robot/move,robot/camera
MQTT_RECONNECT_DELAY=5
DEVICE_ID=myaong-pi-01

# Desktop FastAPI backend reachable from Raspberry Pi.
# Leave empty to auto-discover Ai-Myaong backend on port 8000.
# The desktop backend sends this URL only when scanning Wi-Fi networks.
# Example: DESKTOP_BACKEND_URL=http://192.168.0.24:8000
DESKTOP_BACKEND_URL=
DESKTOP_BACKEND_PORT=8000
# Seconds between background Pi IP registrations to the desktop backend.
DESKTOP_BACKEND_REGISTER_INTERVAL=300
# Roll back to the previous Wi-Fi if backend registration or MQTT reconnect fails.
ROLLBACK_WIFI_ON_BACKEND_REGISTER_FAILURE=true
# Set true only if Wi-Fi change must roll back when backend MQTT reconnect fails.
REQUIRE_BACKEND_MQTT_ON_REGISTER=false
# Validate wlan0 IP and default gateway after Wi-Fi change.
WIFI_VALIDATE_GATEWAY=true
# Optional. Example: WIFI_VALIDATE_INTERNET_HOST=8.8.8.8
WIFI_VALIDATE_INTERNET_HOST=
# Optional. Leave empty to scan the Raspberry Pi's /24 subnet.
# Example: DESKTOP_BACKEND_DISCOVERY_CIDR=192.168.0.0/24
DESKTOP_BACKEND_DISCOVERY_CIDR=

# Set these only if your broker requires authentication.
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Serial connection to the Arduino/robot controller.
SERIAL_PORT=auto
SERIAL_BAUD=115200
SERIAL_DEBUG=false

# true keeps serial output simulated, but MQTT still receives messages.
SIMULATION_MODE=false

# Set true only when you want to start the Pi agent without MQTT.
MQTT_DISABLED=false

# MJPEG camera stream server. scripts/start-raspberrypi.sh starts this by default.
START_CAMERA_STREAM=true
STREAM_PORT=8080
CAMERA_PYTHON_BIN=/usr/bin/python3
CAMERA_BACKEND=picamera2
CAMERA_WIDTH=640
CAMERA_HEIGHT=360
CAMERA_FPS=15
CAMERA_JPEG_QUALITY=82
CAMERA_FRAME_WAIT_TIMEOUT=2
CAMERA_MAX_CAPTURE_FAILURES=30

# HTTP control agent for backend network setup APIs.
PI_AGENT_HTTP_DISABLED=false
PI_AGENT_HTTP_HOST=0.0.0.0
PI_AGENT_HTTP_PORT=8765
