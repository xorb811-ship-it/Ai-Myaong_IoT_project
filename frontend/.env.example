# API and realtime services
VITE_API_BASE_URL=https://myaong-production-d3b8.up.railway.app
# Optional. Defaults to VITE_API_BASE_URL converted to ws/wss with /ws/connect.
VITE_WS_URL=wss://myaong-production-d3b8.up.railway.app/ws/connect
VITE_MQTT_BROKER_URL=ws://localhost:9001
VITE_STREAM_URL=
# Flip only the displayed MJPEG image. OpenCV worker must use the same horizontal flip.
VITE_VISION_FLIP_HORIZONTAL=true

# ESP32 Wi-Fi setup
VITE_ESP32_SETUP_URL=http://192.168.4.1
VITE_ESP32_MQTT_HOST=auto

# Google OAuth client ID from Google Cloud Console.
# 공개값(publishable)이라 기록해 둠. 코드에도 기본값 내장되어 .env 없이도 작동.
VITE_GOOGLE_CLIENT_ID=1034586846978-d24vdc078j1ae041c1d77anqrc3s005j.apps.googleusercontent.com

# EmailJS verification email settings.
# 공개값(publishable). 코드에도 기본값 내장되어 .env 없이도 실제 발송됨.
VITE_EMAILJS_SERVICE_ID=service_ys3gyas
VITE_EMAILJS_TEMPLATE_ID=template_5517zca
VITE_EMAILJS_PUBLIC_KEY=QpoSG0GYOKglql4ec
